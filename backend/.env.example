SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///data/secureai.db

# Local authorized lab mode (default: true)
LOCAL_LAB_MODE=true
ALLOWED_LAB_HOSTS=localhost,127.0.0.1,::1,test.local,dvwa.local,juice-shop.local
ALLOWED_LAB_PORTS=3000,3001,5000,8000,8001,8080,8081,8090,8888

# External scanning is disabled unless explicitly enabled and allowlisted
ALLOW_EXTERNAL_TARGETS=false
PUBLIC_TARGET_ALLOWLIST=

# Scanner limits
SCAN_CONNECT_TIMEOUT=3
SCAN_READ_TIMEOUT=8
MAX_RESPONSE_BYTES=1048576
MAX_PAGES_PER_SCAN=8
SCAN_RATE_LIMIT_PER_HOUR=20
TOKEN_TTL_HOURS=24

# Optional demonstration-only ML classifier trained on synthetic data
USE_SYNTHETIC_ML=false

# Optional OWASP ZAP integration (read-only alert import)
OWASP_ZAP_URL=
OWASP_ZAP_API_KEY=

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
